# ── Reload (agent communication layer) ─────────────────────────────
# Get tokens from your Reload workspace. NEVER commit real keys.
RELOAD_API_TOKEN=rl_sk_xxxxxxxxxxxxxxxxxxxx
# Optional per-agent overrides:
# RELOAD_TOKEN_HERMES=
# RELOAD_TOKEN_OPENCLAW=
# RELOAD_TOKEN_CODEX=
# RELOAD_TOKEN_SENTINEL=

# Reload channel ids (from the Reload app)
RELOAD_CHANNEL_OPS=chan_xxxxxxxx
RELOAD_CHANNEL_CONTENT=chan_xxxxxxxx
RELOAD_CHANNEL_MEAT_STORE=chan_xxxxxxxx

# ── Model providers ────────────────────────────────────────────────
# MiniMax subscription key (powers Codex via the Sentinel-Ollama bridge)
MINIMAX_API_KEY=sk-cp-xxxxxxxxxxxxxxxxxxxx

# ── Content pipeline ───────────────────────────────────────────────
# Freepik membership API key (stock search + AI image generation)
FREEPIK_API_KEY=FPSXxxxxxxxxxxxxxxxxxxxx

# ── Memory ─────────────────────────────────────────────────────────
# Optional: self-hosted TencentDB-Agent-Memory service URL
# AGENT_MEMORY_URL=http://localhost:8080

# ── Existing ───────────────────────────────────────────────────────
NALEDI_PASSWORD=
